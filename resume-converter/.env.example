# Copy to .env.local and fill in. Never commit real keys.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Stripe TEST mode keys (sk_test_...). Live keys are refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_ALLOW_LIVE=true   # only when you deliberately go live

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: override the model (default claude-opus-5-5). Cheaper option: claude-sonnet-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Public URL used for Stripe redirects and magic links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_TEST_MODE=true   # set to false when going live
